 "cards":[
  {"dot":"emerald","title":"Kubernetes Service routing","items":["NodePort is available on cluster nodes; requests can be forwarded to a ready pod on another node. Local arrows are illustrative, not a locality guarantee.","Workload pods are conditional placements, not three guaranteed replicas."]},
  {"dot":"amber","title":"Observability","items":["The collector receives UE observations, fetches SMF/AMF mappings, and exposes rolling metrics to Prometheus.","Prometheus can scrape node exporters across the cluster; only the core scrape is drawn for clarity."]},
  {"dot":"violet","title":"Control and deployment assumptions","items":["Collector and Prometheus select site=core; this frame assumes one core node. Controller execution host and Kubernetes API host are not specified by the repository.","Mobility-aware placement is a soft preference. Mutation is disabled by default."]}
 ]
